    "def plot_cosine_heatmap(matrix, title, ax=None, cmap='coolwarm'):\n",
    "    M = matrix.shape[0]\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(4.5, 4))\n",
    "    im = ax.imshow(matrix, vmin=0.0, vmax=1.0, cmap=cmap)\n",
    "    for i in range(M):\n",
    "        for j in range(M):\n",
    "            val = matrix[i, j]\n",
    "            color = 'white' if val > 0.7 else 'black'\n",
    "            ax.text(j, i, f'{val:.2f}', ha='center', va='center', color=color, fontsize=9)\n",
    "    labels = [f'$E_{{{i+1}}}$' for i in range(M)]\n",
    "    ax.set_xticks(range(M), labels)\n",
    "    ax.set_yticks(range(M), labels)\n",
    "    ax.set_title(title)\n",
    "    plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04)\n",
    "    return ax\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(5, 4.5))\n",
    "plot_cosine_heatmap(\n",
    "    avg_matrix,\n",
    "    title=f'GMOE_Full — cosine sim.\\n({DATASET_NAME}, avg over {len(per_env_matrices)} test envs, seed{SEED})',\n",
    "    ax=ax,\n",
    ")\n",
    "plt.tight_layout()\n",
    "\n",
    "out_path = REPO_ROOT / 'multi_dataset' / f'cosine_sim_GMOE_Full_{DATASET_NAME}.png'\n",
    "plt.savefig(out_path, dpi=200, bbox_inches='tight')\n",
    "print('saved:', out_path)\n",
    "plt.show()"
   ]
  },
