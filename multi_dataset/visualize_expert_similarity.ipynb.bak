      "checkpoint template: /home/hungnt/hungnt/DG-OMOE/multi_dataset/GMOE_Full/OfficeHome/env{env}/seed0/train_output/model.pkl\n"
     ]
    }
   ],
   "source": [
    "# Configuration\n",
    "DATASET_NAME = 'OfficeHome'\n",
    "DATA_DIR = str(REPO_ROOT / 'domainbed' / 'data')\n",
    "\n",
    "ALGO_DIR_NAME = 'GMOE_Full'                      # folder under multi_dataset/\n",
    "ALGORITHM_CLASS = 'GMOE_Full'\n",
    "SEED = 0                                         # only use seed0 checkpoints\n",
    "TEST_ENVS = [0, 1, 2, 3]                         # all 4 OfficeHome domains\n",
    "BATCH_SIZE = 64\n",
    "HOLDOUT_FRACTION = 0.2\n",
    "TRIAL_SEED = 0                                   # matches split seed used during training\n",
    "\n",
    "CHECKPOINT_TMPL = str(REPO_ROOT / 'multi_dataset' / ALGO_DIR_NAME / DATASET_NAME / 'env{env}' / f'seed{SEED}' / 'train_output' / 'model.pkl')\n",
    "print('checkpoint template:', CHECKPOINT_TMPL)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d8316ee6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "num envs: 4\n",
      "num classes: 65\n",
      "input shape: (3, 224, 224)\n",
      "env0: total=2427, in_split=1942, out_split=485\n",
      "env1: total=4365, in_split=3492, out_split=873\n",
      "env2: total=4439, in_split=3552, out_split=887\n",
      "env3: total=4357, in_split=3486, out_split=871\n"
     ]
    }
   ],
   "source": [
    "# Load dataset once (reused across test envs)\n",
    "default_hparams = hparams_registry.default_hparams(ALGORITHM_CLASS, DATASET_NAME)\n",
    "dataset = vars(datasets)[DATASET_NAME](DATA_DIR, test_envs=[0], hparams=default_hparams)\n",
    "print('num envs:', len(dataset))\n",
    "print('num classes:', dataset.num_classes)\n",
    "print('input shape:', dataset.input_shape)\n",
    "\n",
    "# Build in-splits (same logic as train.py:179-196, using TRIAL_SEED=0 to match training)\n",
    "all_in_splits = []\n",
    "for env_i, env in enumerate(dataset):\n",
    "    out, in_ = misc.split_dataset(\n",
    "        env,\n",
    "        int(len(env) * HOLDOUT_FRACTION),\n",
    "        misc.seed_hash(TRIAL_SEED, env_i),\n",
    "    )\n",
    "    all_in_splits.append(in_)\n",
    "    print(f'env{env_i}: total={len(env)}, in_split={len(in_)}, out_split={len(out)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "60f34125",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_gmoe_full_from_checkpoint(ckpt_path, device):\n",
    "    \"\"\"Rebuild GMOE_Full from checkpoint and load state dict.\"\"\"\n",
    "    ckpt = torch.load(ckpt_path, map_location=device, weights_only=False)\n",
    "    algo_class = vars(algorithms)[ALGORITHM_CLASS]\n",
    "    algo = algo_class(\n",
    "        input_shape=ckpt['model_input_shape'],\n",
    "        num_classes=ckpt['model_num_classes'],\n",
    "        num_domains=ckpt['model_num_domains'],\n",
    "        hparams=ckpt['model_hparams'],\n",
    "    )\n",
    "    algo.load_state_dict(ckpt['model_dict'])\n",
    "    algo.to(device)\n",
    "    algo.eval()\n",
    "    return algo\n",
    "\n",
    "\n",
    "def collect_expert_outputs(algo, loader, device):\n",
    "    \"\"\"Return h_stack of shape (N, M, r) over the whole loader.\"\"\"\n",
    "    all_h = []\n",
    "    with torch.no_grad():\n",
    "        for x, _y in loader:\n",
    "            x = x.to(device)\n",
    "            _logits, _pi, h_stack = algo._forward(x)   # (B, M, r)\n",
    "            all_h.append(h_stack.cpu())\n",
    "    return torch.cat(all_h, dim=0)   # (N, M, r)\n",
    "\n",
    "\n",
    "def per_sample_cosine_matrix(h):\n",
    "    \"\"\"\n",
    "    h: (N, M, r)\n",
    "    Returns: (M, M) matrix of mean pairwise cosine similarity across samples.\n",
    "    \"\"\"\n",
    "    h_norm = F.normalize(h, dim=-1)                 # (N, M, r)\n",
    "    # per-sample cosine: (N, M, r) @ (N, r, M) → (N, M, M)\n",
    "    cos = torch.einsum('nmr,nkr->nmk', h_norm, h_norm)\n",
    "    return cos.mean(dim=0).numpy()                  # (M, M)"
   ]
  },
