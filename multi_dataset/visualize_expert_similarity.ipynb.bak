   "source": [
    "gmoe_per_env_matrices = []\n",
    "\n",
    "for test_env in TEST_ENVS:\n",
    "    ckpt_path = GMOE_CHECKPOINT_TMPL.format(env=test_env)\n",
    "    if not os.path.exists(ckpt_path):\n",
    "        print(f'[SKIP] env{test_env}: {ckpt_path}')\n",
    "        continue\n",
    "\n",
    "    print(f'[env{test_env}] loading {ckpt_path}')\n",
    "    algo, state_dict = load_gmoe_model(ckpt_path, device)\n",
    "\n",
    "    loader = FastDataLoader(\n",
    "        dataset=all_in_splits[test_env],\n",
    "        batch_size=BATCH_SIZE,\n",
    "        num_workers=dataset.N_WORKERS,\n",
    "    )\n",
    "\n",
    "    h = collect_gmoe_baseline_experts(algo, state_dict, loader, device, layer_idx=MOE_LAYER_IDX)\n",
    "    print(f'  collected CLS expert outputs: shape={tuple(h.shape)}')\n",
    "\n",
    "    cos_mat = per_sample_cosine_matrix(h)   # reuse helper from cell 4\n",
    "    M_ = cos_mat.shape[0]\n",
    "\n",
    "    # Sanity assertions (same as used for GMOE_Full, ensuring fair comparison)\n",
    "    assert cos_mat.shape == (6, 6), f'expected (6,6) got {cos_mat.shape}'\n",
    "    assert np.allclose(np.diag(cos_mat), 1.0, atol=1e-5), f'diagonal not 1: {np.diag(cos_mat)}'\n",
    "    assert np.allclose(cos_mat, cos_mat.T, atol=1e-5), 'matrix not symmetric'\n",
    "\n",
    "    gmoe_per_env_matrices.append(cos_mat)\n",
    "    print(f'  cos min={cos_mat.min():.4f}, max_off_diag={(cos_mat - np.eye(M_)).max():.4f}')\n",
    "\n",
    "    del algo, state_dict, h, loader\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "assert len(gmoe_per_env_matrices) > 0, 'No GMOE checkpoints found!'\n",
    "gmoe_avg_matrix = np.mean(gmoe_per_env_matrices, axis=0)\n",
    "print(f'\\nGMOE baseline: averaged across {len(gmoe_per_env_matrices)} test envs')"
   ]
  },
