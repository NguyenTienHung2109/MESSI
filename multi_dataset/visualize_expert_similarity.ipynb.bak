    "# GMOE baseline heatmap\n",
    "fig, ax = plt.subplots(figsize=(5, 4.5))\n",
    "plot_cosine_heatmap(\n",
    "    gmoe_avg_matrix,\n",
    "    title=f'GMOE (baseline) — cosine sim.\\n({DATASET_NAME}, avg over {len(gmoe_per_env_matrices)} envs, seed{SEED})',\n",
    "    ax=ax,\n",
    ")\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPO_ROOT / 'multi_dataset' / f'cosine_sim_GMOE_{DATASET_NAME}.png', dpi=200, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# Side-by-side: GMOE baseline vs GMOE_Full (matches paper figure layout)\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 4.5))\n",
    "plot_cosine_heatmap(gmoe_avg_matrix,          ax=axes[0])\n",
    "plot_cosine_heatmap(avg_matrix, ax=axes[1])\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPO_ROOT / 'multi_dataset' / f'cosine_sim_compare_{DATASET_NAME}.png', dpi=200, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# Summary stats\n",
    "M = gmoe_avg_matrix.shape[0]\n",
    "off_diag_gmoe = gmoe_avg_matrix[~np.eye(M, dtype=bool)]\n",
    "off_diag_full = avg_matrix[~np.eye(M, dtype=bool)]\n",
    "print('\\n== Summary (off-diagonal cosine) ==')\n",
    "print(f'GMOE baseline:  mean={off_diag_gmoe.mean():.4f}, max={off_diag_gmoe.max():.4f}, min={off_diag_gmoe.min():.4f}')\n",
    "print(f'GMOE_Full:      mean={off_diag_full.mean():.4f}, max={off_diag_full.max():.4f}, min={off_diag_full.min():.4f}')"
