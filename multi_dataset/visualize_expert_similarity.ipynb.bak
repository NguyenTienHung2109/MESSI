   "source": [
    "# Compute cosine-similarity matrix for each test_env, then average across envs\n",
    "per_env_matrices = []\n",
    "\n",
    "for test_env in TEST_ENVS:\n",
    "    ckpt_path = CHECKPOINT_TMPL.format(env=test_env)\n",
    "    if not os.path.exists(ckpt_path):\n",
    "        print(f'[SKIP] env{test_env}: checkpoint not found at {ckpt_path}')\n",
    "        continue\n",
    "\n",
    "    print(f'[env{test_env}] loading {ckpt_path}')\n",
    "    algo = load_gmoe_full_from_checkpoint(ckpt_path, device)\n",
    "\n",
    "    loader = FastDataLoader(\n",
    "        dataset=all_in_splits[test_env],\n",
    "        batch_size=BATCH_SIZE,\n",
    "        num_workers=dataset.N_WORKERS,\n",
    "    )\n",
    "\n",
    "    h = collect_expert_outputs(algo, loader, device)\n",
    "    print(f'  collected h_stack: shape={tuple(h.shape)} (N={h.size(0)} samples)')\n",
    "\n",
    "    cos_mat = per_sample_cosine_matrix(h)\n",
    "\n",
    "    # Sanity assertions (same as GMOE baseline, ensuring fair comparison)\n",
    "    assert cos_mat.shape == (6, 6), f'expected (6,6) got {cos_mat.shape}'\n",
    "    assert np.allclose(np.diag(cos_mat), 1.0, atol=1e-5), f'diagonal not 1: {np.diag(cos_mat)}'\n",
    "    assert np.allclose(cos_mat, cos_mat.T, atol=1e-5), 'matrix not symmetric'\n",
    "\n",
    "    per_env_matrices.append(cos_mat)\n",
    "    print(f'  cos min={cos_mat.min():.4f}, max_off_diag={(cos_mat - np.eye(cos_mat.shape[0])).max():.4f}')\n",
    "\n",
    "    del algo, h, loader\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "assert len(per_env_matrices) > 0, 'No checkpoints found!'\n",
    "avg_matrix = np.mean(per_env_matrices, axis=0)\n",
    "print(f'\\nAveraged across {len(per_env_matrices)} test envs. Final shape: {avg_matrix.shape}')"
   ]
  },
